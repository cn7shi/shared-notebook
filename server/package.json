{
  "name": "shared-notebook-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "npm run build && node dist/scripts/dev.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "contract": "npm run build && node dist/scripts/contract.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "~5.9.3"
  }
}
